<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap mp rescap">
  <Identity Name="BiliXbox.Community" Publisher="CN=BiliXboxDev" Version="1.0.2.0" />
  <mp:PhoneIdentity PhoneProductId="dd37d151-a70b-4a16-bb32-edb20c943620" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties><DisplayName>弹幕舱</DisplayName><PublisherDisplayName>BiliXbox Community</PublisherDisplayName><Logo>Assets\StoreLogo.png</Logo></Properties>
  <Dependencies><TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" /></Dependencies>
  <Resources><Resource Language="zh-CN" /></Resources>
  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="BiliXbox.App">
      <uap:VisualElements DisplayName="弹幕舱" Description="弹幕舱：面向 Xbox 的第三方 Bilibili 客户端" BackgroundColor="#0D0D10" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile ShortName="弹幕舱" Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0D0D10" />
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities><Capability Name="internetClient" /><rescap:Capability Name="hevcPlayback" /></Capabilities>
</Package>

