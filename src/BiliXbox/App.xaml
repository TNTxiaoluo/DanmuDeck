<Application x:Class="BiliXbox.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="using:Windows.UI.Xaml.Controls.Primitives">
  <Application.Resources>
    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#FB7299" />
    <SolidColorBrush x:Key="SystemControlHighlightAltAccentBrush" Color="#FB7299" />
    <!-- tvOS-like focus: white, not brand pink. -->
    <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#00000000" />
    <SolidColorBrush x:Key="TvFocusFillBrush" Color="#FFF5F5F7" />
    <SolidColorBrush x:Key="TvFocusForegroundBrush" Color="#FF111216" />
    <SolidColorBrush x:Key="TvSecondaryTextBrush" Color="#99FFFFFF" />

    <!-- Lightweight styling of native controls that keep their own templates. -->
    <SolidColorBrush x:Key="SliderTrackFill" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#55FFFFFF" />
    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#55FFFFFF" />
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFE5E5EA" />
    <SolidColorBrush x:Key="ContentDialogBackground" Color="#F51C1D23" />
    <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#00000000" />
    <SolidColorBrush x:Key="TextControlBackground" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#00000000" />

    <!-- Shared tvOS-style button: translucent pill at rest; focused it fills
         white, darkens its text and lifts slightly. Scale runs on the compositor. -->
    <ControlTemplate x:Key="TvButtonTemplate" TargetType="primitives:ButtonBase">
      <Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><ScaleTransform x:Name="FocusScale" /></Grid.RenderTransform>
        <VisualStateManager.VisualStateGroups>
          <VisualStateGroup x:Name="CommonStates">
            <VisualState x:Name="Normal" />
            <VisualState x:Name="PointerOver">
              <Storyboard><DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" /></Storyboard>
            </VisualState>
            <VisualState x:Name="Pressed">
              <Storyboard><DoubleAnimation Storyboard.TargetName="ContentRoot" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.08" /></Storyboard>
            </VisualState>
            <VisualState x:Name="Disabled">
              <Storyboard><DoubleAnimation Storyboard.TargetName="ContentRoot" Storyboard.TargetProperty="Opacity" To="0.38" Duration="0:0:0.15" /></Storyboard>
            </VisualState>
          </VisualStateGroup>
          <VisualStateGroup x:Name="FocusStates">
            <VisualState x:Name="Focused">
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="FocusFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                <DoubleAnimation Storyboard.TargetName="FocusScale" Storyboard.TargetProperty="ScaleX" To="1.07" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="FocusScale" Storyboard.TargetProperty="ScaleY" To="1.07" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground"><DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TvFocusForegroundBrush}" /></ObjectAnimationUsingKeyFrames>
              </Storyboard>
            </VisualState>
            <VisualState x:Name="Unfocused">
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="FocusFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                <DoubleAnimation Storyboard.TargetName="FocusScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="FocusScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
              </Storyboard>
            </VisualState>
            <VisualState x:Name="PointerFocused" />
          </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid x:Name="ContentRoot">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" />
          <Border x:Name="HoverFill" Background="#14FFFFFF" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
          <Border x:Name="FocusFill" Background="{StaticResource TvFocusFillBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
          <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}" Padding="{TemplateBinding Padding}"
                            Foreground="{TemplateBinding Foreground}" FontWeight="{TemplateBinding FontWeight}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            AutomationProperties.AccessibilityView="Raw" />
        </Grid>
      </Grid>
    </ControlTemplate>

    <Style x:Key="TvButtonStyle" TargetType="Button">
      <Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="22,10" /><Setter Property="MinHeight" Value="48" />
      <Setter Property="CornerRadius" Value="24" /><Setter Property="Background" Value="#1FFFFFFF" />
      <Setter Property="Foreground" Value="#F2FFFFFF" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="UseSystemFocusVisuals" Value="False" /><Setter Property="FocusVisualPrimaryThickness" Value="0" />
      <Setter Property="FocusVisualSecondaryThickness" Value="0" />
      <Setter Property="Template" Value="{StaticResource TvButtonTemplate}" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource TvButtonStyle}" />
    <!-- A wide search field keeps its geometry while focused. Content inherits
         the presenter's foreground so white focus fill retains readable text. -->
    <Style x:Key="TvSearchEntryStyle" TargetType="Button" BasedOn="{StaticResource TvButtonStyle}">
      <Setter Property="Background" Value="#1AFFFFFF" />
      <Setter Property="Foreground" Value="#B7BECE" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" /><VisualState x:Name="PointerOver" /><VisualState x:Name="Pressed" />
                  <VisualState x:Name="Disabled"><Storyboard><DoubleAnimation Storyboard.TargetName="SearchEntryPresenter" Storyboard.TargetProperty="Opacity" To="0.38" Duration="0" /></Storyboard></VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                  <VisualState x:Name="Unfocused" /><VisualState x:Name="PointerFocused" />
                  <VisualState x:Name="Focused"><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="SearchEntryFocusFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SearchEntryPresenter" Storyboard.TargetProperty="Foreground"><DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TvFocusForegroundBrush}" /></ObjectAnimationUsingKeyFrames>
                  </Storyboard></VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
              <Border x:Name="SearchEntryFocusFill" Background="{StaticResource TvFocusFillBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
              <ContentPresenter x:Name="SearchEntryPresenter" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ToggleButton">
      <Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="22,10" /><Setter Property="MinHeight" Value="48" />
      <Setter Property="CornerRadius" Value="24" /><Setter Property="Background" Value="#1FFFFFFF" />
      <Setter Property="Foreground" Value="#F2FFFFFF" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="UseSystemFocusVisuals" Value="False" /><Setter Property="FocusVisualPrimaryThickness" Value="0" />
      <Setter Property="FocusVisualSecondaryThickness" Value="0" />
      <Setter Property="Template" Value="{StaticResource TvButtonTemplate}" />
    </Style>
    <!-- Wide drawer rows keep focus within their own scrolling viewport. They
         must not reuse the pill's 1.07 scale or leave the previous row lit while
         a second root-canvas outline moves to the next control. -->
    <ControlTemplate x:Key="TvRowButtonTemplate" TargetType="Button">
      <Grid x:Name="RowRoot">
        <VisualStateManager.VisualStateGroups>
          <VisualStateGroup x:Name="CommonStates">
            <VisualState x:Name="Normal" />
            <VisualState x:Name="PointerOver"><Storyboard><DoubleAnimation Storyboard.TargetName="RowHoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" /></Storyboard></VisualState>
            <VisualState x:Name="Pressed"><Storyboard><DoubleAnimation Storyboard.TargetName="RowPresenter" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0" /></Storyboard></VisualState>
            <VisualState x:Name="Disabled"><Storyboard><DoubleAnimation Storyboard.TargetName="RowRoot" Storyboard.TargetProperty="Opacity" To="0.38" Duration="0" /></Storyboard></VisualState>
          </VisualStateGroup>
          <VisualStateGroup x:Name="FocusStates">
            <VisualState x:Name="Focused"><Storyboard>
              <DoubleAnimation Storyboard.TargetName="RowFocusFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RowPresenter" Storyboard.TargetProperty="Foreground"><DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TvFocusForegroundBrush}" /></ObjectAnimationUsingKeyFrames>
            </Storyboard></VisualState>
            <VisualState x:Name="Unfocused"><Storyboard><DoubleAnimation Storyboard.TargetName="RowFocusFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0" /></Storyboard></VisualState>
            <VisualState x:Name="PointerFocused" />
          </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" />
        <Border x:Name="RowHoverFill" Background="#14FFFFFF" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
        <Border x:Name="RowFocusFill" Background="{StaticResource TvFocusFillBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
        <ContentPresenter x:Name="RowPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                          ContentTransitions="{TemplateBinding ContentTransitions}" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                          FontWeight="{TemplateBinding FontWeight}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" AutomationProperties.AccessibilityView="Raw" />
      </Grid>
    </ControlTemplate>
    <!-- Wide list-row buttons (settings drawers): left aligned, softer corners. -->
    <Style x:Key="TvRowButtonStyle" TargetType="Button" BasedOn="{StaticResource TvButtonStyle}">
      <Setter Property="CornerRadius" Value="14" /><Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Padding" Value="18,12" /><Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Template" Value="{StaticResource TvRowButtonTemplate}" />
    </Style>
    <Style TargetType="TextBox"><Setter Property="FontSize" Value="18" /><Setter Property="MinHeight" Value="48" /><Setter Property="CornerRadius" Value="12" /></Style>

    <!-- One poster layout for recommendations, search and creator uploads.
         The 282px slot contains the complete 246px card plus focus clearance. -->
    <DataTemplate x:Key="TvVideoCardTemplate">
      <Grid Width="246" Margin="18,14,18,24" HorizontalAlignment="Center" ToolTipService.ToolTip="{Binding Title}">
        <Grid Tag="TvShadow" IsHitTestVisible="False" />
        <StackPanel Spacing="10">
          <Grid Height="138" Background="#1C1C1E" CornerRadius="12">
            <Image Source="{Binding CoverUrl}" Stretch="UniformToFill" />
            <Border CornerRadius="12">
              <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0.45" /><GradientStop Color="#D9000000" Offset="1" /></LinearGradientBrush></Border.Background>
            </Border>
            <TextBlock Text="{Binding PlayText}" FontSize="12" Foreground="#CCF2F2F7" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10,0,0,8" />
            <Border Background="#CC000000" CornerRadius="6" Padding="6,3" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,8,8">
              <TextBlock Text="{Binding DurationText}" FontSize="12" Foreground="#F2F2F7" />
            </Border>
          </Grid>
          <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="#F2F2F7" TextWrapping="Wrap" MaxLines="2" Height="44" TextTrimming="CharacterEllipsis" LineHeight="22" />
          <TextBlock Text="{Binding Owner}" FontSize="13" Foreground="#8E8E93" TextTrimming="CharacterEllipsis" Height="18" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <!-- Poster cards. Focus lift/shadow is applied by TvFocusEffects on the
         container's composition visual so it tracks scrolling exactly. -->
    <Style x:Key="TvCardItemStyle" TargetType="GridViewItem">
      <Setter Property="Margin" Value="0" /><Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="UseSystemFocusVisuals" Value="False" />
      <Setter Property="FocusVisualPrimaryThickness" Value="0" /><Setter Property="FocusVisualSecondaryThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GridViewItem">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              ContentTransitions="{TemplateBinding ContentTransitions}" Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- A dynamic post uses the same lift treatment without the native
         full-row selection rectangle. Stretch the content to its card width. -->
    <Style x:Key="TvDynamicItemStyle" TargetType="ListViewItem">
      <Setter Property="Margin" Value="0" /><Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="UseSystemFocusVisuals" Value="False" />
      <Setter Property="FocusVisualPrimaryThickness" Value="0" /><Setter Property="FocusVisualSecondaryThickness" Value="0" />
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTransitions="{TemplateBinding ContentTransitions}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
  </Application.Resources>
</Application>
